{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdsuretasktasker",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "r2_buckets": [
    {
      "binding": "PROOF_STORAGE",
      "bucket_name": "cdsure-proofs"
    },
    {
      "binding": "PROOFS",
      "bucket_name": "cdsure-proofs"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "cdsure-c360f",
    "ADMIN_EMAILS": "bunnynurse53@gmail.com,admin@cdsuretasks.com",
    "PUBLIC_PAYSTACK_PUBLIC_KEY": "pk_live_d373a3e0e4c9f6ec3916d30de7a2dacd08b70d90",
    "PAYSTACK_PUBLIC_KEY": "pk_live_d373a3e0e4c9f6ec3916d30de7a2dacd08b70d90"
  }
}
