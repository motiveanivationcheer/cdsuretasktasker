rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'bunnysusanfabio@gmail.com';
    }

    function isValidCloudinaryUrl(url) {
      return url is string
        && url.matches('^https://res\\.cloudinary\\.com/yojvb8cn/.*')
        && !url.matches('^data:.*');
    }

    match /users/{userId} {
      allow read, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn();
    }

    match /cloudinary_images/{imageId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.publicId is string
        && isValidCloudinaryUrl(request.resource.data.secureUrl);
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidCloudinaryUrl(request.resource.data.secureUrl)
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
