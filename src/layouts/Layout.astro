---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CDSure Tasks — Paid Daily Tasks Platform",
  description = "© 2026 CDSure — Paid Daily Tasks Platform. Post tasks as an employer or earn daily cash completing micro-tasks."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#f8fafc] text-[#0f172a] min-h-screen antialiased selection:bg-[#7C3AED] selection:text-white">
    <slot />
  </body>
</html>
