---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-2xl bg-[#7C3AED] flex items-center justify-center shadow-md shadow-purple-600/25">
        <svg class="w-6 h-6 text-white stroke-[3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-extrabold text-lg tracking-tight text-[#0f172a]">
            CDSure <span class="text-[#7C3AED]">Tasks</span>
          </span>
          <span class="text-[10px] font-bold uppercase tracking-wider bg-purple-50 text-[#7C3AED] px-2 py-0.5 rounded-full border border-purple-200">
            PRO
          </span>
        </div>
        <p class="text-[11px] text-slate-400 hidden sm:block">Paid Daily Tasks Platform</p>
      </div>
    </a>

    <!-- Navigation links -->
    <nav class="flex items-center gap-2 sm:gap-3">
      <a
        href="/login"
        class={`px-3.5 py-1.5 rounded-xl text-xs font-bold transition ${
          currentPath === "/login"
            ? "bg-purple-50 text-[#7C3AED]"
            : "text-slate-600 hover:text-slate-900 hover:bg-slate-50"
        }`}
      >
        Sign In
      </a>
      <a
        href="/signup"
        class="px-4 py-1.5 rounded-xl text-xs font-bold bg-[#7C3AED] hover:bg-[#6D28D9] text-white shadow-sm transition"
      >
        Sign Up
      </a>
    </nav>
  </div>
</header>
